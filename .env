# APP_ENV=production
# APP_URL=https://planner.example.com
# CORS_ORIGIN=https://planner.example.com
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=strict
# TRUST_PROXY=1

