
# Environment mode
# Use development for local runs and production for the deployed site.
APP_ENV=development
PORT=3003
TRUST_PROXY=0

# Local example
APP_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3003
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

