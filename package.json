    "Cesium",
    "Cesium JS",
    "3D viewer",
    "urban planning",
    "real estate planning",
    "terrain visualization",
    "QGIS",
    "web mapping",
    "open source"
  ],
  "author": "MundoGIS",
  "license": "MPL-2.0",
  "engines": {
