  },
  "dependencies": {
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "connect-flash": "0.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "4.22.2",
    "express-fileupload": "1.5.0",
    "express-session": "1.19.0",
    "fs-extra": "11.2.0",
    "helmet": "7.0.0",
    "node-windows": "1.0.0-beta.8"
  },
  "devDependencies": {
    "nodemon": "3.0.1"
  },
